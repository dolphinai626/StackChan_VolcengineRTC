+// nano newlib printf 不支持 %llu，自行实现 uint64 -> 十进制字符串
+static void volc_u64_to_str(uint64_t v, char* buf, size_t buflen) {
+    char tmp[24];
+    int i = 0;
+    if (v == 0) {
+        if (buflen >= 2) { buf[0] = '0'; buf[1] = '\0'; }
+        return;
+    }
+    while (v > 0 && i < (int)sizeof(tmp)) {
+        tmp[i++] = '0' + (int)(v % 10);
+        v /= 10;
+    }
+    int n = i < (int)buflen - 1 ? i : (int)buflen - 1;
+    for (int k = 0; k < n; k++) buf[k] = tmp[i - 1 - k];
+    buf[n] = '\0';
+}
